{
  "name": "wow-ah-prediction",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "analyze": "bun src/ai/main.ts",
    "digest": "bun src/digest-cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "companion": "bun src/companion/main.ts",
    "build:companion": "bun build --compile --target=bun-windows-x64 src/companion/main.ts --outfile dist/wahp-companion.exe",
    "build:companion:linux": "bun build --compile src/companion/main.ts --outfile dist/wahp-companion"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "zod": "^4.6.7"
  }
}
