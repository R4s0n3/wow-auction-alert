PORT=3000
DB_PATH=data/wahp.sqlite
# Pflicht für POST /scans (Companion schickt "Authorization: Bearer <token>")
INGEST_TOKEN=
# Leer = alle GET-Routen offen (lokal ok). Im Netz setzen: Lesen dann nur mit diesem Token
# (Authorization: Bearer … oder ?token=…). Der Companion kommt mit seinem INGEST_TOKEN rein.
READ_TOKEN=
# Optional: Discord-Webhook für Live-Alerts
DISCORD_WEBHOOK_URL=
ENGINE_INTERVAL_MIN=15
DEFAULT_REALM=eu
# Mindest-Gewinn nach 5 % AH-Gebühr, ab dem "kaufen" empfohlen wird
MIN_UPSIDE=0.15
MIN_CONFIDENCE=0.25

# KI-Analyse mit Claude (bun run analyze). Ohne Key laufen nur die Handregeln.
# Einen der beiden Keys eintragen. Ist nur OPENROUTER_API_KEY gesetzt, läuft alles über OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional erzwingen, wenn beide Keys gesetzt sind: anthropic oder openrouter
AI_PROVIDER=
# Anthropic-Schreibweise, für OpenRouter wird daraus anthropic/claude-opus-5.5
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_BUDGET_USD=10
AI_BRIEF_MAX_AGE_HOURS=24
AI_REASSESS_HOURS=72
AI_CHUNK_SIZE=40
AI_CONCURRENCY=3
# 0 = nur von Hand. Sonst analysiert der Server selbst alle N Stunden (kostet Geld).
AI_INTERVAL_HOURS=0
AI_MAX_AGE_DAYS=14
